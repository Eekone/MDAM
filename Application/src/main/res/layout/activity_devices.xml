<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.texnoprom.mdam.activities.DevicesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <android.support.design.widget.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/AppTheme.AppBarOverlay">

            <android.support.v7.widget.Toolbar
                android:id="@+id/devicesToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:popupTheme="@style/AppTheme.PopupOverlay" />
        </android.support.design.widget.AppBarLayout>

        <ScrollView
            style="@android:style/Widget.DeviceDefault.Light.ScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/ptmBkm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/layout_bg"
                    android:minHeight="48dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:text="ПТМ.БКМ-1.0"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <Button
                    android:id="@+id/eltechBip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/layout_bg"
                    android:minHeight="48dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:text="ЭЛТЕХ.БИП-1"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <Button
                    android:id="@+id/BKM1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/layout_bg"
                    android:minHeight="48dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:text="ПВЕК.БКМ-3М"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <Button
                    android:id="@+id/BKM4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/layout_bg"
                    android:minHeight="48dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:text="ПВЕК.БКМ-4"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <Button
                    android:id="@+id/MMPR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/mmpr_bg"
                    android:minHeight="48dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:text="ПВЕК.ММПР"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <Button
                    android:id="@+id/OPE11"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/ope_bg"
                    android:minHeight="48dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:text="ЭНЕРГОМЕРА.ОПЕ-М11"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:typeface="sans" />

                <Button
                    android:id="@+id/OPE14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/ope_bg"
                    android:enabled="false"
                    android:minHeight="48dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:text="ЭНЕРГОМЕРА.ОПЕ-М14"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:typeface="sans" />

            </LinearLayout>
        </ScrollView>


    </LinearLayout>
</android.support.design.widget.CoordinatorLayout>
